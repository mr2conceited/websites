# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/mediplus_hospital
MONGODB_TEST_URI=mongodb://localhost:27017/mediplus_hospital_test

# JWT Configuration
JWT_SECRET=your-9b1ecf13d7912184b04d02f83be465b1c82f3c18c39731cf6424db5d7593a1a0
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS Configuration
